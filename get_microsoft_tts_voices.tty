#!/usr/bin/env python3
"""
Fetches available Microsoft TTS voices for one or more languages
and generates a Home Assistant YAML config snippet suitable for
direct inclusion via `microsoft: !include microsoft_voices.yaml`.

Usage:
    # Single language
    python get_microsoft_tts_voices.py --key YOUR_API_KEY --language de-DE --region westeurope

    # Multiple languages
    python get_microsoft_tts_voices.py --key YOUR_API_KEY --language de en-US fr --region westeurope

    # Neural voices only, written to a file
    python get_microsoft_tts_voices.py --key YOUR_API_KEY --language de en --neural-only > microsoft_voices.yaml
"""

import argparse
import json
import re
import sys
import urllib.request
import urllib.error

VOICES_URL = "https://{region}.tts.speech.microsoft.com/cognitiveservices/voices/list"


def fetch_voices(api_key: str, region: str) -> list[dict]:
    url = VOICES_URL.format(region=region)
    req = urllib.request.Request(url, headers={"Ocp-Apim-Subscription-Key": api_key})
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        print(f"HTTP error {e.code}: {e.reason}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Connection error: {e.reason}", file=sys.stderr)
        sys.exit(1)


def sanitize(text: str) -> str:
    """Replace any run of non-alphanumeric characters with a single underscore."""
    return re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")


def is_hd_voice(voice: dict) -> bool:
    """HD voices require a different API format not supported by pycsspeechtts."""
    name = voice.get("ShortName", "") + voice.get("DisplayName", "")
    return bool(re.search(r"\bHD\b", name, re.IGNORECASE))


def is_unsupported_voice(voice: dict) -> bool:
    """Filter out voice schemes that don't work with pycsspeechtts.
    This includes HD voices and colon-scheme voices like 'Ethan:MAI-Voice-2'.
    """
    return is_hd_voice(voice) or ":" in voice.get("ShortName", "")


def generate_yaml(voices: list[dict], api_key_secret: str, region: str, volume: int) -> str:
    lines = []
    skipped = []

    for voice in voices:
        if is_unsupported_voice(voice):
            skipped.append(voice["ShortName"])
            continue

        short_name = voice["ShortName"]           # e.g. de-DE-KatjaNeural
        display_name = voice["DisplayName"]       # e.g. Katja
        locale = voice["Locale"].lower()          # e.g. de-de
        gender = voice["Gender"]                  # Female / Male / Neutral
        if gender == "Neutral":
            gender = "Female"  # HA only accepts Female/Male; Neutral mapped to Female
        voice_type = short_name.split("-", 2)[2]  # e.g. KatjaNeural

        # sanitize: lowercase, spaces/special chars -> underscores
        service_name = f"microsoft_{sanitize(locale)}_{sanitize(display_name)}"

        lines.append(f"- api_key: !secret {api_key_secret}")
        lines.append(f"  service_name: {service_name}")
        lines.append(f"  language: {locale}")
        lines.append(f"  type: {voice_type}")
        lines.append(f"  gender: {gender}")
        lines.append(f"  region: {region}")
        if volume is not None:
            lines.append(f"  volume: {volume}")
        lines.append("")

    if skipped:
        lines.append("# Skipped unsupported voices (HD or colon-scheme, not supported by pycsspeechtts):")
        for name in skipped:
            lines.append(f"#   {name}")

    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description="Generate HA YAML for Microsoft TTS voices")
    parser.add_argument("--key",         required=True,  help="Azure Speech API key")
    parser.add_argument("--language",    required=True,  nargs="+", help="Language filter(s), e.g. de-DE en-US or just de en")
    parser.add_argument("--region",      default="westeurope", help="Azure region (default: westeurope)")
    parser.add_argument("--neural-only", action="store_true",  help="Only include Neural voices")
    parser.add_argument("--secret",      default="azure_api_key", help="HA secret name for the API key")
    parser.add_argument("--volume",      type=int, default=None, help="Volume offset (-100 to 100); omitted from output if not specified")
    parser.add_argument("--list",        action="store_true", help="Just list voice names, no YAML")
    args = parser.parse_args()

    print(f"Fetching voices from region '{args.region}'...", file=sys.stderr)
    all_voices = fetch_voices(args.key, args.region)

    # Filter by language (case-insensitive prefix match, multiple filters supported)
    lang_filters = [l.lower() for l in args.language]
    voices = [
        v for v in all_voices
        if any(v["Locale"].lower().startswith(f) for f in lang_filters)
    ]

    if args.neural_only:
        voices = [v for v in voices if "Neural" in v["ShortName"]]

    if not voices:
        print(f"No voices found for language(s): {', '.join(args.language)}", file=sys.stderr)
        sys.exit(1)

    print(f"Found {len(voices)} voice(s) for '{', '.join(args.language)}':", file=sys.stderr)
    for v in voices:
        hd = "  [skipped]" if is_unsupported_voice(v) else ""
        print(f"  {v['ShortName']:50s}  {v['Gender']}{hd}", file=sys.stderr)
    print(file=sys.stderr)

    if args.list:
        return

    yaml_out = generate_yaml(voices, args.secret, args.region, args.volume)
    print(yaml_out)


if __name__ == "__main__":
    main()
